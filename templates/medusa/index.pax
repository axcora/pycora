---
layout: medusa/landing
---
<article class="card p-2">
<div class="p-5">
{{content |safe}}
</div>
</article>

<section class="card mt-3">
<div class="row p-3 align-items-center">
<div class="col-lg-7 col-md-12 col-12 p-3">
<div class="col-lg-10 col-md-10">
<h2 class="text-3xl font-bold mb-3"><a href="{{url}}">{{ section1.title }}</a></h2>
<p>{{ section1.description }}</p>
</div>
</div>
<div class="col-lg-5 col-md-12 col-12 p-3">
<img class="img-fluid shadow" width="100%" height="100%" loading="eager" src="{{ section1.image }}" alt="{{ section1.image_alt }}"/>
</div>
</div>
</section>

<section class="card mt-3">
<div class="row p-3 align-items-center">
<div class="col-lg-5 col-md-12 col-12 p-3">
<img class="img-fluid shadow" width="100%" height="100%" src="{{ section2.image }}" alt="{{ section2.image_alt }}"/>
</div>
<div class="col-lg-1 col-md-0 col-0"></div>
<div class="col-lg-6 col-md-12 col-12 p-3">
<h2 class="text-3xl font-bold mb-3"><a href="{{url}}">{{ section2.title }}</a></h2>
<p>{{ section2.description }}</p>
<ul>
{% for item in section2.list %}
<li>{{ item }}</li>
{% endfor %}
</ul>
</div>
</div>
</section>

<section class="card mt-3">
<div class="row p-3 text-center">
<div class="col-12 p-4">
<h3><a href="{{url}}">{{ section3.title }}</a></h3>
<p>{{ section3.subtitle }}</p>
<p><small>{{ section3.note }}</small></p>
</div>
</div>
</section>


<div class="row">

{% for post in posts.medusa[:3] %}
<div class="col-lg-4 col-md-6 col-12 p-2">
<div class="card p-2">
<a href="{{post.url}}"><img class="img-fluid shadow" loading="lazy"  width="100%" height="100%"
	src="{{post.image or medusa.image}}"/></a>
    <div class="p-3">
        <h3><a href="{{post.url}}" class="text-dark">{{post.title}}</a></h3>
        <p>{{post.description}}</p>
    </div>
    <div class="card-footer text-center">{{ post.date.strftime('%B %d, %Y') }}</div>
</div>
</div>
{% endfor %}


</div>
