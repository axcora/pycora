---
layout: medusa/default
---
<div class="row">

<div class="col-12 col-lg-8 col-md-8 p-2">
<div class="card p-2">
<img class="img-fluid shadow" 
	src="{{image or medusa.image}}"/>
    <div class="p-5">
    {% if toc %}
<div class="card p-5 mt-3 mb-3">
<h4>Table of Contents</h4>
{{ toc | safe }}
</div>
{% endif %}
{{content| safe }}
</div>
	
<ul class="pagination">
  <li class="page-item">{% if prev_post %}
    <a class="page-link" href="{{prev_post.url}}">Previous</a>
    {% endif %}
  </li>
    <li class="page-item">{% if next_post %}
        <a class="page-link" href="{{ next_post.url }}">Next</a>
        {% endif %}
    </li>
</ul>
</div>
</div>



<div class="col-12 col-lg-4 col-md-4 p-2">

<div class="card p-2 centered">
<img class="img-fluid shadow" 
alt="{{medusa.about.title}}"
width="220" height="220"
src="{{medusa.about.logo}}"/>
<div class="p-3 text-center">
<h3>{{medusa.about.title}}</h3>
<p>{{medusa.about.description}}</p>
<a href="{{medusa.about.button.url}}" class="mt-3 full btn btn-primary">{{medusa.about.button.text}}</a>
</div>
</div>

<div class="card p-2 mt-2">
<div class="p-3">
<h3 class="mb-3">Tags</h3>
{% for t in tags %}
<a href="/tags/{{ t }}" class="btn btn-outline-secondary btn-sm m-1">#{{ t }}</a>
{% endfor %}
</div>
</div>

</div>
</div>

{% if related_posts %}
<section class="card p-3">
    <div class="row g-4">
    <h2 class="col-lg-12 text-center p-3 fw-bold mb-2">Related Posts</h2>
        {% for related in related_posts[:3] %} 
        <div class="col-md-4">
            <div class="blog-card h-100" style="padding: 1.5rem;">
                {% if related.metadata.image %}
                <a href="{{ related.url }}">
                    <img class="img-fluid rounded-3 mt2 mb-2 shadow-sm" alt="{{ related.metadata.title }}" 
                         width="100%" height="100%" loading="lazy"
                         src="{{ related.metadata.image }}"/>
                </a>
                {% endif %}
                <h3><a href="{{ related.url }}" class="post-title" style="font-size: 1.1rem;">
                    {{ related.metadata.title }}
                </a></h3>
                <p>
                    <span class="text-muted"><small>
                    {{ related.date.strftime('%b %d, %Y') }}
                    </small>
                    </span>
                </p>
            </div>
        </div>
        {% endfor %}
    </div>
</section>
{% endif %}