<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta name="google-site-verification" content="fJTzwsNcz2AtRxQpJZzU7db7TLPdR_lKSAXfyWDtHB4">
	<meta name="google-site-verification" content="Xi3WpckDbMBvm1pdlc5XukNoA9uWDmnExIiOeaTOxq0">

  {% set _site = medusa.main_url | trim %}
  {% set _page = page.url or url or "/" %}
  {% set _canonical = _site.rstrip("/") + _page %}
  {% set _title = title or medusa.title %}
  {% set _desc = description or medusa.description %}
  {% set _img = image or medusa.image %}
  {% set _img_abs = _img if _img.startswith("http") else _site.rstrip("/") + _img %}
  {% set _fav = medusa.favicon if medusa.favicon.startswith("http") else _site.rstrip("/") + medusa.favicon %}

  <title>{{ _title }}</title>
  <meta name="description" content="{{ _desc }}">
  <meta name="author" content="{{ author or medusa.author }}">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="{{ _canonical }}">
  <link rel="icon" href="{{ _fav }}" type="image/x-icon">

  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ _title }}">
  <meta property="og:description" content="{{ _desc }}">
  <meta property="og:url" content="{{ _canonical }}">
  <meta property="og:site_name" content="{{ medusa.name }}">
  <meta property="og:image" content="{{ _img_abs }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ _title }}">
  <meta name="twitter:description" content="{{ _desc }}">
  <meta name="twitter:image" content="{{ _img_abs }}">
  <meta name="twitter:site" content="{{ medusa.twitter_username }}">
  <meta name="twitter:creator" content="{{ medusa.twitter_username }}">

  <link rel="alternate" type="application/rss+xml" title="{{ medusa.name }}" href="{{ _site.rstrip('/') }}/feed.xml">
  <meta name="generator" content="PyCora Medusa v2.0">

  <link rel="preload" href="https://cdn.jsdelivr.net/npm/axcora-css@1.0.1/axcora.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/axcora-css@1.0.1/axcora.min.css"></noscript>
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6422989243541464" crossorigin="anonymous"></script>
  <style>
    html,body{font-size:16px}
    .cover{max-width:100%;height:460px;object-fit:cover}
    ul,ol {margin-left: 2.5rem !important;}
    .centered {justify-content: center; align-items: center; display: flex;}
    .full {width: 100%;}
    .text-white {color: #fff !important;}
    hr{margin-top: 8px; margin-bottom: 15px;}
    a {text-decoration:none; color:inherit; font-weight: bold;}
    @media(max-width:767px){.cover{height:220px}}
    @media(min-width:768px) and (max-width:1023px){.cover{height:360px}}
  </style>
</head>
<body>
  {% include "partials/medusa/nav" %}
  {% include "partials/medusa/hero" %}
  <main class="container mt-2 mb-2">
    {{ content }}
  </main>
  {% include "partials/medusa/footer" %}
  <script src="https://cdn.jsdelivr.net/npm/axcora-js@1.0.1/axcora.min.js"></script>
</body>
</html>