<section class="gothic-section" id="versioning">
  <div class="gothic-container">
    <div class="section-header">
      <span class="section-tag">{{ versioning.tag }}</span>
      <h2 class="section-title"><a href="{{medusa.url}}">{{ versioning.title }}</a></h2>
      <p class="section-desc">{{ versioning.desc }}</p>
    </div>
    <div class="philosophy-grid">
      {% for v in versioning.versions %}
      <div class="philosophy-card {% if 'Medusa' in v.title %}medusa-card{% endif %}">
        <span class="philosophy-num">{{ v.num }}</span>
        <div class="philosophy-icon">{{ v.icon }}</div>
        <h3 class="philosophy-title"><a href="{{medusa.url}}" class="inhe">{{ v.title }}</a></h3>
        <img class="img-fluid" loading="lazy" alt="{{ v.title }}" width="100%" height="100%" src="{{ v.image }}"/>
        <p class="philosophy-text">{{ v.text }}</p>
        <ul class="version-features">
          {% for f in v.features %}
          <li>{{ f }}</li>
          {% endfor %}
        </ul>
        
          <div class="mt-3">
         <a href="{{ v.button.url }}" class="btn-gothic btn-{{ v.button.style }}">
                {{ v.button.text }}
              </a>
              </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>